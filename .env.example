# KeepAI Environment Configuration Template

# Frontend build URL. Set this to the backend origin (no trailing slash or /api).
VITE_API_URL=http://localhost:8000

# Backend server configuration
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=495955126205-jfajsdml27qi172pfc88ub5hed20pd16.apps.googleusercontent.com

# Database Configuration (options: postgres, mysql, mariadb, sqlite)
# For hosted PostgreSQL, set DATABASE_URL and DB_TYPE=postgres.
DATABASE_URL=
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=keepai
DB_PATH=./data/keepai.db
CHROMA_PATH=./data/chroma

# AI Provider Configuration (options: gemini, ollama, openai, anthropic)
AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_PROJECT_ID=

# Authentication & Security Configuration
JWT_SECRET_KEY=replace-with-a-unique-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Web Push (derived from JWT_SECRET_KEY by default; optional dedicated pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@keepai-app.vercel.app

# Ollama Configuration (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Storage Configuration
